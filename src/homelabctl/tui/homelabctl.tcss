/* =========================================================
   HomeLabCTL
   Dashboard V2.1
   ========================================================= */

Screen {
    background: #0d1012;
    color: #d9dcde;
}

Header {
    height: 1;
    background: #3d454a;
    color: #f3f5f6;
}

Footer {
    height: 1;
    background: #061657;
    color: #eceff1;
}


/* =========================================================
   DASHBOARD
   ========================================================= */

#dashboard-root {
    width: 100%;
    height: 100%;
    padding: 1;
}


/* =========================================================
   TOP SERVICE STRIP
   ========================================================= */

#service-strip {
    width: 100%;
    height: 4;

    border: round #00aee8;

    padding: 0 1;

    margin-bottom: 1;

    align: left middle;
}

#service-info {
    width: 1fr;
    height: 100%;

    content-align: left middle;

    color: #d9dcde;
}

#refresh-dashboard {
    width: 14;
    height: 3;
}


/* =========================================================
   BODY
   ========================================================= */

#dashboard-body {
    width: 100%;
    height: 1fr;
}


/* =========================================================
   MAIN 2x2 GRID
   ========================================================= */

#main-grid {
    width: 1fr;
    height: 100%;

    layout: grid;

    grid-size: 2 2;
    grid-columns: 0.94fr 1.06fr;
    grid-rows: 1fr 1fr;

    grid-gutter: 1 1;

    margin-right: 1;
}

.dashboard-panel {
    width: 100%;
    height: 100%;

    border: round #00aee8;

    background: #101416;

    padding: 0 1;

    overflow: hidden hidden;
}


/* =========================================================
   CONSISTENT PANEL HEADERS
   ========================================================= */

.panel-header-button,
.panel-header-static {
    width: 100%;
    height: 3;

    padding: 0 1;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;
    text-align: left;

    border-bottom: solid #23748b;
}

.panel-header-button {
    background: transparent;

    border-top: none;
    border-left: none;
    border-right: none;
}

.panel-header-button:hover {
    background: #12242b;
    color: #ffffff;
}

.panel-header-button:focus {
    background: #123341;
    color: #ffffff;
}

.panel-content {
    width: 100%;
    height: 1fr;

    padding: 1;
}


/* =========================================================
   LIVE PANES
   ========================================================= */

#logs-live,
#diagnostics-live,
#file-watch-live {
    width: 100%;
    height: 1fr;

    background: transparent;

    padding: 1;

    overflow: hidden hidden;

    scrollbar-size: 0 0;
}


/* =========================================================
   FEATURE SIDEBAR
   ========================================================= */

#feature-sidebar {
    width: 29;
    min-width: 27;
    max-width: 31;

    height: 100%;

    border: round #00aee8;

    background: #101416;

    padding: 0 1;

    overflow: hidden hidden;
}

#features-title {
    width: 100%;
    height: 3;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;

    padding-left: 1;

    border-bottom: solid #23748b;

    margin-bottom: 1;
}


/* =========================================================
   FEATURE ROW
   ========================================================= */

.feature-row {
    width: 100%;
    height: 2;

    padding: 0 1;

    content-align: left middle;

    background: #111719;

    border-bottom: solid #26363c;
}

.feature-row:hover {
    background: #123342;
}

.feature-row:focus {
    background: #075d7c;
    color: #ffffff;

    border-left: solid #20d3f3;
}

.feature-row:disabled {
    color: #737a7d;
    background: #101315;
}


/* =========================================================
   COMPACT HEIGHT
   ========================================================= */

#dashboard-root.compact-height {
    padding: 0 1;
}

#dashboard-root.compact-height #service-strip {
    height: 3;
    margin-bottom: 1;
}

#dashboard-root.compact-height #refresh-dashboard {
    height: 2;
}

#dashboard-root.compact-height .panel-header-button,
#dashboard-root.compact-height .panel-header-static {
    height: 2;
    padding: 0;
}

#dashboard-root.compact-height .panel-content {
    padding: 0 1;
}

#dashboard-root.compact-height #logs-live,
#dashboard-root.compact-height #diagnostics-live,
#dashboard-root.compact-height #file-watch-live {
    padding: 0 1;
}

#dashboard-root.compact-height #features-title {
    height: 2;
    margin-bottom: 0;
}

#dashboard-root.compact-height .feature-row {
    height: 1;
    border-bottom: none;
}


/* =========================================================
   COMPACT WIDTH
   ========================================================= */

#dashboard-root.compact-width #feature-sidebar {
    width: 27;
    min-width: 27;
}

#dashboard-root.compact-width #main-grid {
    grid-columns: 1fr 1fr;
}

#dashboard-root.compact-width #service-info {
    text-overflow: ellipsis;
}


/* =========================================================
   GENERIC MODULE SCREEN
   ========================================================= */

.module-screen {
    width: 100%;
    height: 100%;

    padding: 1 2;
}

.screen-heading {
    height: 3;

    align: left middle;

    margin-bottom: 1;
}

.screen-title {
    width: 1fr;

    text-style: bold;
}

#module-screen-status {
    width: 18;

    margin-right: 1;
}

#module-screen-summary {
    width: 100%;
    height: auto;

    border: round #24758f;

    padding: 1;

    margin-bottom: 1;
}

#module-values {
    width: 100%;
    height: 1fr;

    border: round #24758f;

    padding: 1;
}

#module-values-content {
    width: 100%;
    height: auto;
}


/* =========================================================
   STATUS BADGE
   ========================================================= */

.status-badge {
    width: auto;
    height: 1;

    text-style: bold;
}

.status-pass {
    color: #4ee071;
}

.status-warning {
    color: #f2c744;
}

.status-fail,
.status-error {
    color: #ff5f5f;
}

.status-unknown,
.status-unavailable,
.status-not_configured {
    color: #8b9195;
}

.status-drift {
    color: #f29d49;
}


/* =========================================================
   DIALOGS
   ========================================================= */

.dialog {
    width: 72;
    max-width: 90%;

    height: auto;
    max-height: 85%;

    border: round #00aee8;

    background: #15191c;

    padding: 1 2;

    align: center middle;
}

.dialog-title {
    width: 100%;

    text-align: center;
    text-style: bold;

    margin-bottom: 1;
}

.dialog-summary {
    width: 100%;
    height: auto;

    margin-bottom: 1;
}

.dialog-meta {
    width: 100%;

    color: #969ca0;

    margin-bottom: 1;
}

.dialog-warning {
    width: 100%;

    color: #f2c744;

    text-style: bold;

    margin: 1 0;
}

.dialog-error {
    width: 100%;

    color: #ff5f5f;

    margin-bottom: 1;
}

.dialog-content {
    height: auto;
    max-height: 20;

    border: round #24758f;

    padding: 1;

    margin-bottom: 1;
}

.dialog Button {
    width: 100%;

    margin-top: 1;
}


/* =========================================================
   Dashboard V2.2
   Left feature rail + spatial navigation
   ========================================================= */

#dashboard-body {
    width: 100%;
    height: 1fr;
}


/* LEFT FEATURE RAIL */

#feature-sidebar {
    width: 29;
    min-width: 27;
    max-width: 31;

    height: 100%;

    margin-right: 1;

    border: round #00aee8;

    background: #101416;

    padding: 0 1;

    overflow: hidden hidden;
}

#features-title {
    width: 100%;
    height: 3;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;

    padding-left: 1;

    border-bottom: solid #23748b;

    margin-bottom: 1;
}


/* FEATURE ITEMS */

.feature-row {
    width: 100%;
    height: 2;

    padding: 0 1;

    content-align: left middle;

    background: #111719;

    border-bottom: solid #26363c;

    color: #d5d7d8;
}

.feature-row.feature-unavailable {
    color: #6f7679;
}

.feature-row:hover {
    background: #123342;
}

.feature-row:focus {
    background: #075d7c;

    color: #ffffff;

    border-left: solid #20d3f3;
}

.feature-row.feature-unavailable:focus {
    background: #253137;

    color: #d3d6d8;

    border-left: solid #78868c;
}


/* MAIN AREA NOW SITS TO THE RIGHT */

#main-grid {
    width: 1fr;
    height: 100%;

    layout: grid;

    grid-size: 2 2;
    grid-columns: 0.94fr 1.06fr;
    grid-rows: 1fr 1fr;

    grid-gutter: 1 1;

    margin-right: 0;
}


/* PANEL FOCUS SHOULD BE OBVIOUS */

.panel-header-button:focus {
    background: #075d7c;

    color: #ffffff;

    border-bottom: solid #20d3f3;
}

.panel-header-button:hover {
    background: #123342;

    color: #ffffff;
}


/* SMALL TERMINAL */

#dashboard-root.compact-height #features-title {
    height: 2;

    margin-bottom: 0;
}

#dashboard-root.compact-height .feature-row {
    height: 1;

    border-bottom: none;
}

#dashboard-root.compact-width #feature-sidebar {
    width: 26;
    min-width: 26;
}

#dashboard-root.compact-width #main-grid {
    grid-columns: 1fr 1fr;
}

/* === SSH SCREEN START === */

#ssh-page {
    width: 100%;
    height: 100%;
    background: #0b0e10;
    color: #d9dde0;
}


/* =========================================================
   TOP SERVICE BAR
   ========================================================= */

#ssh-service-strip {
    width: 100%;
    height: 3;

    padding: 0 1;

    background: #0c1114;

    border-bottom: solid #1b728c;

    align: left middle;
}

#ssh-service-info {
    width: 100%;
    height: 100%;

    content-align: left middle;
}


/* =========================================================
   BODY
   ========================================================= */

#ssh-body {
    width: 100%;
    height: 1fr;

    padding: 1;
}


/* =========================================================
   LEFT FEATURE SIDEBAR
   ========================================================= */

#ssh-feature-sidebar {
    width: 29;
    min-width: 27;
    max-width: 31;

    height: 100%;

    margin-right: 1;

    border: round #00aee8;

    background: #0e1316;

    padding: 0 1;

    overflow: hidden hidden;
}

#ssh-features-title {
    width: 100%;
    height: 3;

    color: #20d3f3;
    text-style: bold;

    content-align: left middle;

    padding-left: 1;

    border-bottom: solid #23748b;

    margin-bottom: 1;
}

#ssh-feature-sidebar .feature-row {
    width: 100%;
    height: 2;

    padding: 0 1;

    content-align: left middle;

    background: #101618;

    border-bottom: solid #26363c;
}

#ssh-feature-sidebar .feature-row:focus {
    background: #075d7c;
    color: #ffffff;

    border-left: solid #20d3f3;
}


/* =========================================================
   MAIN FEATURE AREA
   ========================================================= */

#ssh-main {
    width: 1fr;
    height: 100%;
}


/* =========================================================
   FEATURE HEADER
   ========================================================= */

#ssh-feature-header {
    width: 100%;
    height: 5;

    margin-bottom: 1;

    border-bottom: solid #23748b;

    align: left middle;
}

#ssh-feature-heading {
    width: 1fr;
    height: 100%;
}

#ssh-title {
    width: 100%;
    height: 2;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;
}

#ssh-description {
    width: 100%;
    height: 2;

    color: #b9bec1;
}

#ssh-status {
    width: 24;
    height: 3;

    content-align: center middle;

    text-style: bold;
}


/* =========================================================
   BOX SYSTEM
   ========================================================= */

.ssh-box {
    width: 100%;
    height: 100%;

    border: round #00aee8;

    background: #101416;

    padding: 0 1;

    overflow: hidden hidden;
}

.ssh-box-title {
    width: 100%;
    height: 3;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;

    border-bottom: solid #23748b;

    padding-left: 1;
}

.ssh-box-body {
    width: 100%;
    height: 1fr;

    padding: 1;
}


/* =========================================================
   TOP GRID
   ========================================================= */

#ssh-top-grid {
    width: 100%;
    height: 53%;

    layout: grid;

    grid-size: 3 1;

    grid-columns: 1.05fr 1.30fr 0.85fr;

    grid-gutter: 0 1;

    margin-bottom: 1;
}


/* =========================================================
   CONFIGURATION FORM
   ========================================================= */

#ssh-config-grid {
    width: 100%;
    height: 1fr;

    layout: grid;

    grid-size: 2 11;

    grid-columns: 1fr 1.05fr;

    grid-rows:
        1fr 1fr 1fr 1fr 1fr 1fr
        1fr 1fr 1fr 1fr 1fr;

    grid-gutter: 0 1;

    padding: 0 1;
}

.ssh-field-label {
    width: 100%;
    height: 100%;

    content-align: left middle;

    color: #d8dcde;
}




/* INPUT */

#ssh-config-panel Input {
    background: #10191d;

    border: solid #116a86;

    color: #f1f3f4;

    padding: 0 1;
}

#ssh-config-panel Input:focus {
    border: solid #20d3f3;

    background: #10232b;
}


/* SELECT */






/* =========================================================
   ACTIONS
   ========================================================= */

#ssh-actions-panel {
    padding-bottom: 1;
}

.ssh-action-button {
    width: 100%;
    height: 3;

    margin-bottom: 0;
}

#ssh-preview {
    margin-top: 1;
}

#ssh-quick-title {
    width: 100%;
    height: 3;

    color: #20d3f3;

    content-align: left middle;

    text-style: bold;

    border-top: solid #23748b;

    margin-top: 1;

    padding-top: 1;
}

#ssh-quick-grid {
    width: 100%;
    height: auto;

    layout: grid;

    grid-size: 2 2;

    grid-columns: 1fr 1fr;

    grid-rows: 3 3;

    grid-gutter: 0 1;
}

.ssh-quick-button {
    width: 100%;
    height: 3;
}


/* =========================================================
   BOTTOM GRID
   ========================================================= */

#ssh-bottom-grid {
    width: 100%;
    height: 1fr;

    layout: grid;

    grid-size: 3 1;

    grid-columns: 1.25fr 0.82fr 1.25fr;

    grid-gutter: 0 1;
}


/* =========================================================
   RIGHT STACK
   ========================================================= */

#ssh-info-stack {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 1 2;

    grid-rows: 1fr 1fr;

    grid-gutter: 1 0;
}


/* =========================================================
   DRAFT PREVIEW
   ========================================================= */

#ssh-diff-content {
    color: #d4d8da;
}


/* === SSH SCREEN END === */


/* =========================================================
   SHARED CONTROL CENTER SHELL
   ========================================================= */

#control-shell {
    width: 100%;
    height: 100%;

    background: #0b0e10;

    padding: 0;
}


/* GLOBAL TOP BAR */

#shell-service-strip {
    width: 100%;
    height: 3;

    padding: 0 1;

    background: #0c1114;

    border-bottom: solid #1b728c;

    align: left middle;
}

#shell-service-info {
    width: 1fr;
    height: 100%;

    content-align: left middle;
}

#shell-refresh {
    width: 14;
    height: 2;

    margin-left: 1;
}


/* MAIN SHELL BODY */

#shell-body {
    width: 100%;
    height: 1fr;

    padding: 1;
}


/* PERSISTENT SIDEBAR */

#shell-sidebar {
    width: 29;
    min-width: 27;
    max-width: 31;

    height: 100%;

    margin-right: 1;

    border: round #00aee8;

    background: #0e1316;

    padding: 0 1;

    overflow: hidden hidden;
}

#shell-sidebar-title {
    width: 100%;
    height: 3;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;

    padding-left: 1;

    border-bottom: solid #23748b;

    margin-bottom: 1;
}


/* SIDEBAR FEATURE ROW */

#shell-sidebar .feature-row {
    width: 100%;
    height: 2;

    padding: 0 1;

    content-align: left middle;

    background: #101618;

    border-bottom: solid #26363c;

    color: #cfd4d6;
}

#shell-sidebar .feature-row.feature-unavailable {
    color: #72797c;
}

#shell-sidebar .feature-row:hover {
    background: #123342;
}

#shell-sidebar .feature-row:focus {
    background: #075d7c;

    color: #ffffff;

    border-left: solid #20d3f3;
}

#shell-sidebar .feature-row.current-feature {
    background: #083d51;

    color: #ffffff;

    border-left: solid #20d3f3;
}


/* DYNAMIC FEATURE CONTENT */

#feature-host {
    width: 1fr;
    height: 100%;

    padding: 0;

    overflow: hidden hidden;
}


/* =========================================================
   DASHBOARD VIEW INSIDE SHELL
   ========================================================= */

#dashboard-view {
    width: 100%;
    height: 100%;
}

#dashboard-grid {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 2 2;

    grid-columns: 0.94fr 1.06fr;

    grid-rows: 1fr 1fr;

    grid-gutter: 1 1;
}


/* =========================================================
   SSH VIEW INSIDE SHELL
   ========================================================= */

#ssh-view {
    width: 100%;
    height: 100%;
}

#ssh-content {
    width: 100%;
    height: 100%;

    background: #0b0e10;
}


/* SSH header now begins directly inside content */

#ssh-feature-header {
    width: 100%;
    height: 5;

    margin-bottom: 1;

    border-bottom: solid #23748b;

    align: left middle;
}


/* =========================================================
   SMALL TERMINAL
   ========================================================= */


/* =========================================================
   SSH STAGE 1B OVERRIDES
   ========================================================= */


/* ---------------------------------------------------------
   GLOBAL SHELL
   --------------------------------------------------------- */

#shell-service-strip {
    height: 3;
}

#shell-service-info {
    height: 1;
    content-align: left middle;
}

#shell-refresh {
    width: 12;
    min-width: 10;
    height: 1;

    margin: 0 0 0 1;

    content-align: center middle;
}


/* ---------------------------------------------------------
   SSH ROOT
   --------------------------------------------------------- */

#ssh-view,
#ssh-content {
    width: 100%;
    height: 100%;
}


/* ---------------------------------------------------------
   FEATURE HEADER
   --------------------------------------------------------- */

#ssh-feature-header {
    width: 100%;
    height: 5;

    margin-bottom: 0;

    border-bottom: solid #23748b;
}

#ssh-feature-heading {
    width: 1fr;
    height: 100%;
}

#ssh-title {
    height: 2;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;
}

#ssh-description {
    height: 2;

    color: #b6bdc1;
}

#ssh-status {
    width: 24;
    height: 3;

    content-align: center middle;

    text-style: bold;
}


/* ---------------------------------------------------------
   PAGE SELECTOR
   --------------------------------------------------------- */

#ssh-page-selector {
    width: 100%;
    height: 3;

    align: left middle;

    margin-bottom: 1;
}

.ssh-page-tab {
    width: 16;
    min-width: 12;
    height: 1;

    margin-right: 1;

    color: #8e999e;
}

.ssh-page-tab.active-page-tab {
    color: #20d3f3;
    background: #103a49;

    text-style: bold;
}

#ssh-managed-file-label {
    width: 1fr;
    height: 1;

    color: #7d898e;

    content-align: right middle;
}


/* ---------------------------------------------------------
   CONTENT SWITCHER
   --------------------------------------------------------- */

#ssh-page-switcher {
    width: 100%;
    height: 1fr;
}


/* ---------------------------------------------------------
   COMMON BOXES
   --------------------------------------------------------- */

.ssh-box {
    border: round #00aee8;

    background: #101416;

    padding: 0 1;

    overflow: hidden hidden;
}

.ssh-box-title {
    width: 100%;
    height: 3;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;

    border-bottom: solid #23748b;
}

.ssh-box-body {
    width: 100%;
    height: 1fr;

    padding: 1;
}


/* =========================================================
   PAGE 1 — CONFIGURE
   ========================================================= */

#ssh-page-configure {
    width: 100%;
    height: 100%;
}

#ssh-page-one-grid {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 3 1;

    grid-columns:
        0.92fr
        1.25fr
        0.83fr;

    grid-rows: 1fr;

    grid-gutter: 0 1;
}

.ssh-page-panel {
    height: 100%;
}


/* ---------------------------------------------------------
   CURRENT STATE
   --------------------------------------------------------- */

#ssh-current-content {
    overflow-y: auto;
}


/* ---------------------------------------------------------
   DESIRED CONFIGURATION
   --------------------------------------------------------- */

#ssh-config-scroll {
    width: 100%;
    height: 1fr;

    padding: 0 1;
}

#ssh-config-grid {
    width: 100%;
    height: auto;

    layout: grid;

    grid-size: 2 11;

    grid-columns:
        1fr
        1.08fr;

    grid-rows:
        3 3 3 3 3 3
        3 3 3 3 3;

    grid-gutter: 0 1;
}

.ssh-field-label {
    width: 100%;
    height: 3;

    content-align: left middle;

    color: #d8dcde;
}



#ssh-config-panel Input {
    height: 3;

    background: #10191d;

    border: solid #116a86;

    color: #f1f3f4;

    padding: 0 1;
}

#ssh-config-panel Input:focus {
    border: solid #20d3f3;

    background: #10232b;
}






/* ---------------------------------------------------------
   ACTIONS + MANAGED FILE PREVIEW
   --------------------------------------------------------- */

#ssh-actions-preview-panel {
    height: 100%;
}

#ssh-actions-grid {
    width: 100%;
    height: 4;

    layout: grid;

    grid-size: 2 2;

    grid-columns:
        1fr
        1fr;

    grid-rows:
        1 1;

    grid-gutter: 1 1;

    margin-top: 1;
}

.ssh-small-action {
    width: 100%;
    min-width: 6;
    height: 1;

    content-align: center middle;
}

#ssh-preview-title {
    width: 100%;
    height: 3;

    margin-top: 1;

    color: #20d3f3;

    text-style: bold;

    content-align: left middle;

    border-top: solid #23748b;
}

.ssh-preview-body {
    width: 100%;
    height: 1fr;

    padding: 1 0;

    overflow-y: auto;
}


/* =========================================================
   PAGE 2 — INSPECT
   ========================================================= */

#ssh-page-inspect {
    width: 100%;
    height: 100%;
}

#ssh-page-two-grid {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 3 1;

    grid-columns:
        0.85fr
        1.1fr
        1.15fr;

    grid-rows: 1fr;

    grid-gutter: 0 1;
}

#ssh-sessions-table,
#ssh-keys-table {
    width: 100%;
    height: 1fr;

    background: #0e1214;
}


/* =========================================================
   AUTOMATIC COMPACT MODE
   Triggered from Python Resize event.
   ========================================================= */

ControlCenterScreen.compact-ui #shell-sidebar {
    width: 24;
    min-width: 22;
}

ControlCenterScreen.compact-ui #ssh-description {
    display: none;
}

ControlCenterScreen.compact-ui #ssh-feature-header {
    height: 3;
}

ControlCenterScreen.compact-ui #ssh-title {
    height: 3;
}

ControlCenterScreen.compact-ui #ssh-page-one-grid,
ControlCenterScreen.compact-ui #ssh-page-two-grid {
    height: auto;

    grid-size: 1 3;

    grid-columns: 1fr;

    grid-rows:
        auto
        auto
        auto;

    grid-gutter: 1 0;
}

ControlCenterScreen.compact-ui .ssh-page-panel,
ControlCenterScreen.compact-ui #ssh-verification-panel,
ControlCenterScreen.compact-ui #ssh-sessions-panel,
ControlCenterScreen.compact-ui #ssh-keys-panel {
    height: auto;
    min-height: 14;
}

ControlCenterScreen.compact-ui #ssh-config-panel {
    min-height: 28;
}

ControlCenterScreen.compact-ui #ssh-page-configure,
ControlCenterScreen.compact-ui #ssh-page-inspect {
    overflow-y: auto;
}


/* =========================================================
   TINY MODE
   Nothing important is removed.
   We trade simultaneous visibility for internal scrolling.
   ========================================================= */

ControlCenterScreen.tiny-ui #shell-body {
    padding: 0;
}

ControlCenterScreen.tiny-ui #shell-sidebar {
    width: 22;
    min-width: 20;

    margin-right: 1;
}

ControlCenterScreen.tiny-ui #shell-sidebar-title {
    height: 2;

    margin-bottom: 0;
}

ControlCenterScreen.tiny-ui #shell-sidebar .feature-row {
    height: 1;

    border-bottom: none;
}

ControlCenterScreen.tiny-ui #ssh-description {
    display: none;
}

ControlCenterScreen.tiny-ui #ssh-status {
    width: 18;
}

ControlCenterScreen.tiny-ui #ssh-feature-header {
    height: 3;
}

ControlCenterScreen.tiny-ui #ssh-title {
    height: 3;
}

ControlCenterScreen.tiny-ui #ssh-managed-file-label {
    display: none;
}

ControlCenterScreen.tiny-ui #ssh-page-one-grid,
ControlCenterScreen.tiny-ui #ssh-page-two-grid {
    height: auto;

    grid-size: 1 3;

    grid-columns: 1fr;

    grid-rows:
        auto
        auto
        auto;

    grid-gutter: 1 0;
}

ControlCenterScreen.tiny-ui .ssh-page-panel,
ControlCenterScreen.tiny-ui #ssh-verification-panel,
ControlCenterScreen.tiny-ui #ssh-sessions-panel,
ControlCenterScreen.tiny-ui #ssh-keys-panel {
    height: auto;
    min-height: 12;
}

ControlCenterScreen.tiny-ui #ssh-config-panel {
    min-height: 28;
}

ControlCenterScreen.tiny-ui #ssh-page-configure,
ControlCenterScreen.tiny-ui #ssh-page-inspect {
    overflow-y: auto;
}


/* =========================================================
   SSH STAGE 1C — CONTROL REPAIR
   ========================================================= */


/* ---------------------------------------------------------
   GLOBAL REFRESH
   --------------------------------------------------------- */

#shell-refresh {
    width: 14;
    min-width: 12;
    height: 3;

    margin: 0;

    content-align: center middle;
}


/* ---------------------------------------------------------
   PAGE SELECTOR BUTTONS
   --------------------------------------------------------- */

#ssh-page-selector {
    height: 4;
}

.ssh-page-tab {
    width: 18;
    min-width: 16;
    height: 3;

    margin: 0 1 0 0;

    border: round #116a86;

    background: #10191d;

    color: #b8c2c6;

    content-align: center middle;
}

.ssh-page-tab:hover {
    background: #123441;
}

.ssh-page-tab:focus {
    border: round #20d3f3;

    background: #123441;

    color: #ffffff;
}

.ssh-page-tab.active-page-tab {
    border: round #20d3f3;

    background: #075d7c;

    color: #ffffff;

    text-style: bold;
}

#ssh-managed-file-label {
    height: 3;

    content-align: right middle;
}


/* ---------------------------------------------------------
   FORM CONTROLS
   --------------------------------------------------------- */

.ssh-field-control {
    width: 100%;
}


/*
 * Keep Input customized.
 * Select is intentionally NOT restyled here.
 * Textual owns the Select body / overlay / focus rendering.
 */

#ssh-config-panel Input {
    width: 100%;
    height: 3;

    background: #10191d;

    border: solid #116a86;

    color: #f1f3f4;

    padding: 0 1;
}

#ssh-config-panel Input:focus {
    border: solid #20d3f3;

    background: #10232b;
}


/* ---------------------------------------------------------
   ACTIONS
   --------------------------------------------------------- */

#ssh-actions-grid {
    width: 100%;
    height: 7;

    layout: grid;

    grid-size: 2 2;

    grid-columns:
        1fr
        1fr;

    grid-rows:
        3
        3;

    grid-gutter: 1 1;

    margin-top: 1;
}

.ssh-small-action {
    width: 100%;
    min-width: 8;
    height: 3;

    margin: 0;

    content-align: center middle;
}


/* ---------------------------------------------------------
   DENSITY — PRESERVE EXISTING SYSTEM
   Only make repaired controls fit.
   --------------------------------------------------------- */

ControlCenterScreen.compact-ui .ssh-page-tab {
    width: 15;
    min-width: 13;
}

ControlCenterScreen.compact-ui #ssh-page-selector {
    height: 4;
}

ControlCenterScreen.tiny-ui .ssh-page-tab {
    width: 13;
    min-width: 11;
}

ControlCenterScreen.tiny-ui #ssh-page-selector {
    height: 4;
}

ControlCenterScreen.tiny-ui #shell-refresh {
    width: 10;
    min-width: 9;
}


/* =========================================================
   GLOBAL NAVIGATION VISUAL REPAIR
   ========================================================= */


/* ---------------------------------------------------------
   ACTIVE PAGE != FOCUSED COMPONENT
   --------------------------------------------------------- */

/*
 * Active page is now deliberately subtle.
 *
 * When you're editing Port, Configure should not look as if
 * the Configure button itself still owns keyboard focus.
 */

.ssh-page-tab.active-page-tab {
    background: #0b0e10;

    color: #20d3f3;

    border: round #116a86;

    text-style: bold;
}

.ssh-page-tab:focus {
    background: #075d7c;

    color: #ffffff;

    border: round #20d3f3;

    text-style: bold;
}

.ssh-page-tab.active-page-tab:focus {
    background: #075d7c;

    color: #ffffff;

    border: round #20d3f3;
}


/* ---------------------------------------------------------
   ACTION BUTTONS
   --------------------------------------------------------- */

#ssh-actions-grid Button {
    color: #d9dde0;

    background: #10191d;

    border: round #116a86;
}

#ssh-actions-grid Button:focus {
    color: #ffffff;

    background: #075d7c;

    border: round #20d3f3;
}


/* Preview had invisible text under previous rules. */

#ssh-preview {
    color: #ffffff;

    background: #087cad;

    border: round #20aedd;
}

#ssh-preview:focus {
    color: #ffffff;

    background: #0b8fc5;

    border: round #7be4ff;
}


/* Reset remains visually distinct but readable. */

#ssh-reset {
    color: #101010;

    background: #e1aa13;

    border: round #ffd45d;
}

#ssh-reset:focus {
    color: #000000;

    background: #ffc21c;

    border: round #fff0a5;
}


/* Disabled actions stay visible, but clearly unavailable. */

#ssh-actions-grid Button:disabled {
    color: #64696c;

    background: #17191a;

    border: round #303537;
}


/* ---------------------------------------------------------
   SELECT CONTROLS
   --------------------------------------------------------- */

/*
 * Do not override Select internals.
 *
 * SpaceSelect controls keyboard behavior in Python.
 * Textual owns drawing and expanded option-list behavior.
 */

SpaceSelect {
    width: 100%;
}


/* ---------------------------------------------------------
   NAVIGATION FOCUS SHOULD ALWAYS BE OBVIOUS
   --------------------------------------------------------- */

#ssh-config-panel Input:focus {
    border: round #20d3f3;

    background: #10232b;
}


/* =========================================================
   DENSITY SYSTEM IS UNCHANGED
   ========================================================= */


/* =========================================================
   SSH PREVIEW BUTTON — FINAL REPAIR
   ========================================================= */

#ssh-preview,
#ssh-preview:hover,
#ssh-preview:focus {
    color: #ffffff;
    text-style: bold;
}

#ssh-preview {
    background: #075d7c;
    border: round #20d3f3;
}

#ssh-preview:hover {
    background: #087ca0;
    border: round #49ddff;
}

#ssh-preview:focus {
    background: #078ab5;
    border: round #7beaff;
}


/* =========================================================
   NAV ACTION — PREVIEW
   This is NOT a Textual Button.
   ========================================================= */

#ssh-preview {
    width: 100%;
    height: 3;

    content-align: center middle;

    color: #ffffff;
    background: #075d7c;

    border: round #20d3f3;

    text-style: bold;
}

#ssh-preview:hover {
    color: #ffffff;
    background: #087ca0;

    border: round #49ddff;
}

#ssh-preview:focus {
    color: #ffffff;
    background: #078ab5;

    border: round #7beaff;

    text-style: bold;
}


/* =========================================================
   SSH PREVIEW BUTTON — CLEAN FINAL COMPONENT
   Fresh ID intentionally bypasses all historical
   #ssh-preview rules.
   ========================================================= */

Button#ssh-action-preview {
    width: 100%;
    height: 3;

    color: #ffffff;
    background: #075d7c;

    border: round #20d3f3;

    text-style: bold;

    content-align: center middle;
}

Button#ssh-action-preview:hover {
    color: #ffffff;
    background: #087ca0;

    border: round #49ddff;
}

Button#ssh-action-preview:focus {
    color: #ffffff;
    background: #078ab5;

    border: round #7beaff;

    text-style: bold;
}

/* =========================================================
   E3C2 — SSH FINAL UI POLISH
   ========================================================= */


/* ---------------------------------------------------------
   PREVIEW BUTTON

   Normal:
     same neutral treatment as the other available actions.

   Hover:
     subtle indication only.

   Focus:
     cyan/blue navigation highlight.

   Disabled handling remains owned by the existing generic
   #ssh-actions-grid Button:disabled rule.
   --------------------------------------------------------- */

Button#ssh-action-preview {
    width: 100%;
    height: 3;

    color: #d9dde0;
    background: #10191d;

    border: round #116a86;

    text-style: bold;

    content-align: center middle;
}

Button#ssh-action-preview:hover {
    color: #ffffff;
    background: #123441;

    border: round #20aedd;
}

Button#ssh-action-preview:focus {
    color: #ffffff;
    background: #075d7c;

    border: round #20d3f3;

    text-style: bold;
}


/* ---------------------------------------------------------
   INSPECT — NORMAL / LARGE LAYOUT

   ┌──────────────────────────────────────────────┐
   │ Verification Results                         │
   ├───────────────────┬──────────────────────────┤
   │ Active Sessions   │ Authorized Keys          │
   └───────────────────┴──────────────────────────┘

   Keys receives slightly more width because fingerprints
   and comments need more horizontal room.
   --------------------------------------------------------- */

#ssh-page-two-grid {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 2 2;

    grid-columns:
        1fr
        1.15fr;

    grid-rows:
        auto
        1fr;

    grid-gutter: 1 1;
}

#ssh-verification-panel {
    column-span: 2;

    height: auto;
    min-height: 10;
}

#ssh-sessions-panel,
#ssh-keys-panel {
    height: 1fr;
    min-height: 0;
}


/* ---------------------------------------------------------
   COMPACT MODE

   Preserve the existing density philosophy:
   stack all three panels and allow page scrolling.
   --------------------------------------------------------- */

ControlCenterScreen.compact-ui #ssh-page-two-grid {
    height: auto;

    grid-size: 1 3;

    grid-columns: 1fr;

    grid-rows:
        auto
        auto
        auto;

    grid-gutter: 1 0;
}

ControlCenterScreen.compact-ui #ssh-verification-panel {
    column-span: 1;
}


/* ---------------------------------------------------------
   TINY MODE

   Same stacked structure; existing min-heights and scrolling
   remain responsible for reduced terminal height.
   --------------------------------------------------------- */

ControlCenterScreen.tiny-ui #ssh-page-two-grid {
    height: auto;

    grid-size: 1 3;

    grid-columns: 1fr;

    grid-rows:
        auto
        auto
        auto;

    grid-gutter: 1 0;
}

ControlCenterScreen.tiny-ui #ssh-verification-panel {
    column-span: 1;
}


/* =========================================================
   END E3C2 — SSH FINAL UI POLISH
   ========================================================= */

/* =========================================================
   E3C3 — VERIFICATION PANEL CONTENT FIT
   ========================================================= */

#ssh-verification-panel {
    height: 14;
    min-height: 14;
}

#ssh-verification-content {
    height: 1fr;
    overflow-y: auto;
}

ControlCenterScreen.compact-ui #ssh-verification-panel {
    height: auto;
    min-height: 14;
}

ControlCenterScreen.tiny-ui #ssh-verification-panel {
    height: auto;
    min-height: 12;
}

/* =========================================================
   END E3C3
   ========================================================= */

/* F2B — SSH session action */

#ssh-disconnect-session {
    width: 100%;
    height: 3;
    margin-top: 1;
}


/* =========================================================
   HEADLESS & POWER VIEW
   ========================================================= */

#headless-view,
#headless-content {
    width: 100%;
    height: 100%;
}

#headless-content {
    background: #0b0e10;
}

#headless-feature-header {
    width: 100%;
    height: 5;
    margin-bottom: 0;
    border-bottom: solid #23748b;
    align: left middle;
}

#headless-feature-heading {
    width: 1fr;
    height: 100%;
}

#headless-title {
    height: 2;
    color: #20d3f3;
    text-style: bold;
    content-align: left middle;
}

#headless-description {
    height: 2;
    color: #b6bdc1;
}

#headless-status {
    width: 22;
    height: 3;
    content-align: center middle;
    text-style: bold;
}

#headless-page-selector {
    width: 100%;
    height: 4;
    align: left middle;
    margin-bottom: 1;
}

.headless-page-tab {
    width: 18;
    min-width: 16;
    height: 3;
    margin: 0 1 0 0;
    border: round #116a86;
    background: #10191d;
    color: #b8c2c6;
    content-align: center middle;
}

.headless-page-tab.active-page-tab {
    background: #0b0e10;
    color: #20d3f3;
    border: round #116a86;
    text-style: bold;
}

.headless-page-tab:focus,
.headless-page-tab.active-page-tab:focus {
    background: #075d7c;
    color: #ffffff;
    border: round #20d3f3;
    text-style: bold;
}

#headless-managed-file-label {
    width: 1fr;
    height: 3;
    color: #7d898e;
    content-align: right middle;
}

#headless-page-switcher {
    width: 100%;
    height: 1fr;
}

#headless-page-configure,
#headless-page-inspect {
    width: 100%;
    height: 100%;
}

.headless-box {
    border: round #00aee8;
    background: #101416;
    padding: 0 1;
    overflow: hidden hidden;
}

.headless-box-title {
    width: 100%;
    height: 3;
    color: #20d3f3;
    text-style: bold;
    content-align: left middle;
    border-bottom: solid #23748b;
}

.headless-box-body {
    width: 100%;
    height: 1fr;
    padding: 1;
    overflow-y: auto;
}

#headless-configure-grid {
    width: 100%;
    height: 100%;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 0.95fr 1.05fr 1fr;
    grid-rows: 1fr;
    grid-gutter: 0 1;
}

.headless-page-panel {
    height: 100%;
}

#headless-config-scroll {
    width: 100%;
    height: 1fr;
    padding: 0 1;
}

#headless-config-grid {
    width: 100%;
    height: auto;
    layout: grid;
    grid-size: 2 3;
    grid-columns: 1fr 1.05fr;
    grid-rows: 3 3 3;
    grid-gutter: 0 1;
}

.headless-field-label {
    width: 100%;
    height: 3;
    content-align: left middle;
    color: #d8dcde;
}

#headless-config-panel Input {
    width: 100%;
    height: 3;
    background: #10191d;
    border: solid #116a86;
    color: #f1f3f4;
    padding: 0 1;
}

#headless-config-panel Input:focus {
    border: round #20d3f3;
    background: #10232b;
}

#headless-fixed-profile {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 1;
    border-top: solid #23748b;
}

#headless-actions-grid {
    width: 100%;
    height: 7;
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3 3;
    grid-gutter: 1 1;
    margin-top: 1;
}

#headless-actions-grid Button {
    width: 100%;
    height: 3;
    margin: 0;
    color: #d9dde0;
    background: #10191d;
    border: round #116a86;
}

#headless-actions-grid Button:hover {
    color: #ffffff;
    background: #123441;
    border: round #20aedd;
}

#headless-actions-grid Button:focus {
    color: #ffffff;
    background: #075d7c;
    border: round #20d3f3;
}

#headless-actions-grid Button:disabled {
    color: #64696c;
    background: #17191a;
    border: round #303537;
}

#headless-reset {
    color: #101010;
    background: #e1aa13;
    border: round #ffd45d;
}

#headless-reset:focus {
    color: #000000;
    background: #ffc21c;
    border: round #fff0a5;
}

.headless-preview-body {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    padding: 1 0;
    overflow-y: auto;
    border-top: solid #23748b;
}

#headless-inspect-grid {
    width: 100%;
    height: 100%;
    layout: grid;
    grid-size: 2 1;
    grid-columns: 1.35fr 0.85fr;
    grid-rows: 1fr;
    grid-gutter: 0 1;
}

#headless-verification-panel,
#headless-power-panel {
    height: 100%;
}

ControlCenterScreen.compact-ui #headless-description,
ControlCenterScreen.tiny-ui #headless-description {
    display: none;
}

ControlCenterScreen.compact-ui #headless-feature-header,
ControlCenterScreen.tiny-ui #headless-feature-header {
    height: 3;
}

ControlCenterScreen.compact-ui #headless-title,
ControlCenterScreen.tiny-ui #headless-title {
    height: 3;
}

ControlCenterScreen.tiny-ui #headless-status {
    width: 16;
}

ControlCenterScreen.tiny-ui #headless-managed-file-label {
    display: none;
}

ControlCenterScreen.compact-ui #headless-configure-grid,
ControlCenterScreen.tiny-ui #headless-configure-grid {
    height: auto;
    grid-size: 1 3;
    grid-columns: 1fr;
    grid-rows: auto auto auto;
    grid-gutter: 1 0;
}

ControlCenterScreen.compact-ui .headless-page-panel,
ControlCenterScreen.tiny-ui .headless-page-panel {
    height: auto;
    min-height: 14;
}

ControlCenterScreen.compact-ui #headless-config-panel,
ControlCenterScreen.tiny-ui #headless-config-panel {
    min-height: 24;
}

ControlCenterScreen.compact-ui #headless-inspect-grid,
ControlCenterScreen.tiny-ui #headless-inspect-grid {
    height: auto;
    grid-size: 1 2;
    grid-columns: 1fr;
    grid-rows: auto auto;
    grid-gutter: 1 0;
}

ControlCenterScreen.compact-ui #headless-verification-panel,
ControlCenterScreen.compact-ui #headless-power-panel,
ControlCenterScreen.tiny-ui #headless-verification-panel,
ControlCenterScreen.tiny-ui #headless-power-panel {
    height: auto;
    min-height: 14;
}

ControlCenterScreen.compact-ui #headless-page-configure,
ControlCenterScreen.compact-ui #headless-page-inspect,
ControlCenterScreen.tiny-ui #headless-page-configure,
ControlCenterScreen.tiny-ui #headless-page-inspect {
    overflow-y: auto;
}

/* === END HEADLESS & POWER VIEW === */


/* =========================================================
   HEADLESS CONFIGURABLE POWER POLICY — FINAL OVERRIDES
   ========================================================= */

.headless-section-title {
    width: 100%;
    height: 3;
    margin-top: 1;
    color: #20d3f3;
    text-style: bold;
    content-align: left middle;
    border-bottom: solid #185565;
}

#headless-system-grid,
#headless-desktop-grid,
#headless-gdm-grid {
    width: 100%;
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1.15fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    margin-top: 1;
}

#headless-config-panel .headless-field-control {
    width: 100%;
}

#headless-config-panel SpaceSelect {
    width: 100%;
    height: 3;
}

#headless-config-panel Input {
    width: 100%;
    height: 3;
}

Button#headless-preset {
    width: 100%;
    height: 3;
    margin-top: 1;
    color: #ffffff;
    background: #13323b;
    border: round #20a4c6;
    text-style: bold;
}

Button#headless-preset:hover {
    background: #174856;
    border: round #49ddff;
}

Button#headless-preset:focus {
    background: #075d7c;
    border: round #7beaff;
}

ControlCenterScreen.compact-ui #headless-system-grid,
ControlCenterScreen.compact-ui #headless-desktop-grid,
ControlCenterScreen.compact-ui #headless-gdm-grid,
ControlCenterScreen.tiny-ui #headless-system-grid,
ControlCenterScreen.tiny-ui #headless-desktop-grid,
ControlCenterScreen.tiny-ui #headless-gdm-grid {
    grid-columns: 1fr 1fr;
}

/* === END HEADLESS CONFIGURABLE POWER POLICY === */


/* =========================================================
   HEADLESS PREVIEW SCROLL REPAIR
   ========================================================= */

#headless-preview-scroll {
    width: 100%;
    height: 1fr;
    margin-top: 1;
    border-top: solid #23748b;
    padding-top: 1;
    overflow-y: auto;
}

#headless-preview-content {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    overflow-x: hidden;
    overflow-y: hidden;
}

/* === END HEADLESS PREVIEW SCROLL REPAIR === */


/* =========================================================
   FIREWALL VIEW
   ========================================================= */

#firewall-view,
#firewall-root {
    width: 100%;
    height: 100%;
}

#firewall-feature-header {
    width: 100%;
    height: 4;
    padding: 0 1;
}

#firewall-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
    text-style: bold;
}

#firewall-status {
    width: 16;
    height: 3;
    content-align: right middle;
    text-style: bold;
}

#firewall-page-selector {
    width: 100%;
    height: 4;
    padding: 0 1;
}

.firewall-page-tab {
    width: 18;
    min-width: 14;
    height: 3;
    margin-right: 1;
}

#firewall-pages {
    width: 100%;
    height: 1fr;
}

#firewall-page-configure,
#firewall-page-inspect {
    width: 100%;
    height: 100%;
    padding: 0 1 1 1;
}

#firewall-configure-grid {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 3 1;
    grid-columns:
        0.9fr
        1.1fr
        1fr;

    grid-rows: 1fr;
    grid-gutter: 0 1;
}

#firewall-inspect-grid {
    width: 100%;
    height: 100%;

    layout: grid;

    grid-size: 2 1;
    grid-columns:
        1.2fr
        0.8fr;

    grid-rows: 1fr;
    grid-gutter: 0 1;
}

.firewall-panel {
    width: 100%;
    height: 100%;

    padding: 1;

    background: #0e1214;
    border: round #274854;
}

.firewall-panel-title {
    width: 100%;
    height: 3;

    text-style: bold;
    content-align: left middle;
}

.firewall-field-label {
    width: 100%;
    height: 2;
    margin-top: 1;
}

#firewall-policy-panel Input,
#firewall-policy-panel SpaceSelect {
    width: 100%;
}

#firewall-actions-panel Button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#firewall-safety-note {
    width: 100%;
    height: auto;
    min-height: 7;

    margin-top: 1;
    padding: 1;

    color: #e7c76d;
    background: #181711;
    border: round #6a5a23;
}

#firewall-preview-scroll {
    width: 100%;
    height: 1fr;

    margin-top: 1;
    padding-top: 1;

    border-top: solid #274854;
    overflow-y: auto;
}

#firewall-preview-content {
    width: 100%;
    height: auto;
    min-height: 1;

    overflow-x: hidden;
    overflow-y: hidden;
}

#firewall-current-content,
#firewall-verification-content,
#firewall-runtime-content {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#firewall-preview {
    color: #ffffff;
    background: #075d7c;
    border: round #20d3f3;
    text-style: bold;
}

#firewall-preview:focus {
    background: #078ab5;
    border: round #7beaff;
}

#firewall-reset {
    color: #ffffff;
    background: #202020;
    border: round #4d4d4d;
}

#firewall-reset:focus {
    color: #101010;
    background: #d6a315;
    border: round #f3cb5f;
}

ControlCenterScreen.compact-ui #firewall-configure-grid,
ControlCenterScreen.tiny-ui #firewall-configure-grid {
    height: auto;

    grid-size: 1 3;
    grid-columns: 1fr;
    grid-rows:
        auto
        auto
        auto;

    grid-gutter: 1 0;
}

ControlCenterScreen.compact-ui #firewall-inspect-grid,
ControlCenterScreen.tiny-ui #firewall-inspect-grid {
    height: auto;

    grid-size: 1 2;
    grid-columns: 1fr;
    grid-rows:
        auto
        auto;

    grid-gutter: 1 0;
}

ControlCenterScreen.compact-ui .firewall-panel,
ControlCenterScreen.tiny-ui .firewall-panel {
    height: auto;
    min-height: 14;
}

/* =========================================================
   END FIREWALL VIEW
   ========================================================= */


/* Firewall safe-apply controls */

#firewall-apply {
    color: #ffffff;
    background: #202020;
    border: round #4d4d4d;
}

#firewall-apply:focus {
    color: #ffffff;
    background: #7a4d00;
    border: round #f0ad35;
}

#firewall-confirm-connectivity {
    color: #ffffff;
    background: #173d24;
    border: round #358852;
}

#firewall-confirm-connectivity:focus {
    color: #ffffff;
    background: #246a3b;
    border: round #62d784;
}

#firewall-rollback-now {
    color: #ffffff;
    background: #4b2020;
    border: round #954444;
}

#firewall-rollback-now:focus {
    color: #ffffff;
    background: #7b2929;
    border: round #ef6262;
}

/* ==========================================================
   FIREWALL — CONSOLIDATED MODULE ARCHITECTURE
   ========================================================== */

#firewall-section-nav {
    width: 1fr;
    height: 4;
    padding: 0 1;
    layout: horizontal;
}

.firewall-section-button {
    width: auto;
    min-width: 18;
    height: 3;
    margin: 0 1 0 0;
    background: #202020;
    border: solid #3a3a3a;
}

.firewall-section-button:focus,
.firewall-section-button.active-page-tab {
    border: solid #f2d45c;
}

#firewall-pages {
    width: 1fr;
    height: 1fr;
}

.firewall-section-page {
    width: 1fr;
    height: 1fr;
    padding: 1;
}

.firewall-section-page .firewall-panel {
    border: solid #008b8b;
    padding: 1;
}

.firewall-panel-title {
    height: 2;
    text-style: bold;
}

.firewall-section-note {
    margin-top: 1;
    color: #8f8f8f;
}


/* Overview */

.firewall-overview-row {
    width: 1fr;
    height: 10;
    margin-bottom: 1;
}

.firewall-summary-card {
    width: 1fr;
    height: 10;
    margin-right: 1;
}


/* Access & Network */

#firewall-access-top {
    width: 1fr;
    height: 20;
    margin-bottom: 1;
}

.firewall-access-panel {
    width: 1fr;
    height: 20;
    margin-right: 1;
}

#firewall-management-panel Input {
    width: 38;
    max-width: 48;
    margin-bottom: 1;
}

#firewall-traffic-panel {
    width: 1fr;
    height: 9;
}

#firewall-traffic-row {
    width: 1fr;
    height: 5;
}

.firewall-traffic-setting {
    width: 1fr;
    height: 5;
    margin-right: 1;
}

.firewall-traffic-setting SpaceSelect {
    width: 18;
}


/* Rules */

#firewall-rules-panel {
    width: 1fr;
    height: auto;
    min-height: 8;
}


/* Advanced */

.firewall-advanced-row {
    width: 1fr;
    height: auto;
    min-height: 12;
    margin-bottom: 1;
}

.firewall-advanced-panel {
    width: 1fr;
    height: auto;
    min-height: 12;
    margin-right: 1;
}


/* Persistent Change Control */

#firewall-actions-panel {
    width: 1fr;
    height: 4;
    min-height: 4;
    margin: 0;
    padding: 0 1;
    border-top: solid #3a3a3a;
}

#firewall-change-actions {
    width: 1fr;
    height: 4;
}

#firewall-change-title {
    width: 16;
    content-align: left middle;
    text-style: bold;
}

#firewall-safety-note {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: #a8a8a8;
}

#firewall-change-actions Button {
    width: auto;
    min-width: 9;
    height: 3;
    margin-left: 1;
}

#firewall-preview-scroll {
    display: none;
    width: 1fr;
    height: 0;
    margin: 0;
    padding: 0 1;
    border-top: solid #3a3a3a;
}

#firewall-actions-panel.preview-open {
    height: 18;
    min-height: 18;
}

#firewall-actions-panel.preview-open
#firewall-preview-scroll {
    display: block;
    height: 14;
    padding: 1;
}


/* Density */

ControlCenterScreen.compact-ui
#firewall-section-nav,
ControlCenterScreen.tiny-ui
#firewall-section-nav {
    height: 3;
    padding: 0;
}

ControlCenterScreen.compact-ui
.firewall-section-button,
ControlCenterScreen.tiny-ui
.firewall-section-button {
    height: 3;
    min-width: 15;
    margin-right: 1;
}

ControlCenterScreen.compact-ui
.firewall-section-page,
ControlCenterScreen.tiny-ui
.firewall-section-page {
    padding: 0 1;
}

ControlCenterScreen.compact-ui
#firewall-management-panel Input,
ControlCenterScreen.tiny-ui
#firewall-management-panel Input {
    width: 32;
}

ControlCenterScreen.compact-ui
#firewall-safety-note,
ControlCenterScreen.tiny-ui
#firewall-safety-note {
    display: none;
}

ControlCenterScreen.compact-ui
#firewall-actions-panel,
ControlCenterScreen.tiny-ui
#firewall-actions-panel {
    height: 4;
    min-height: 4;
    padding: 0;
}

ControlCenterScreen.compact-ui
#firewall-actions-panel.preview-open,
ControlCenterScreen.tiny-ui
#firewall-actions-panel.preview-open {
    height: 15;
    min-height: 15;
}

ControlCenterScreen.compact-ui
#firewall-actions-panel.preview-open
#firewall-preview-scroll,
ControlCenterScreen.tiny-ui
#firewall-actions-panel.preview-open
#firewall-preview-scroll {
    height: 11;
}


/* ==========================================================
   FIREWALL — CHANGE CONTROL STATUS REPAIR
   Explicitly neutralizes historical warning-panel styling.
   ========================================================== */

#firewall-change-actions #firewall-safety-note {
    width: 1fr;
    height: 3;
    min-height: 3;

    margin: 0;
    padding: 0 1;

    border: none;
    background: transparent;

    color: #a8a8a8;

    content-align: left middle;
}


/* ==========================================================
   FIREWALL — ACCESS CONTENT CONTAINMENT REPAIR
   Let widget content determine panel height instead of
   clipping Inputs / SpaceSelect controls with fixed rows.
   ========================================================== */

#firewall-access-top {
    height: auto;
    min-height: 25;
}

.firewall-access-panel {
    height: auto;
    min-height: 25;
}

#firewall-management-panel {
    height: auto;
    min-height: 25;
}

#firewall-trusted-panel {
    height: auto;
    min-height: 25;
}

#firewall-traffic-panel {
    height: auto;
    min-height: 9;
}

#firewall-traffic-row {
    height: auto;
    min-height: 5;
}

.firewall-traffic-setting {
    height: auto;
    min-height: 5;
}

#firewall-management-panel Input {
    height: 3;
}

.firewall-traffic-setting SpaceSelect {
    height: 3;
}


/* ==========================================================
   FIREWALL — RULES AND SERVICES MANAGER V1
   ========================================================== */

#firewall-rules-layout {
    width: 1fr;
    height: 1fr;
    layout: horizontal;
}

#firewall-rules-list-panel {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

#firewall-rules-table {
    width: 1fr;
    height: 1fr;
    min-height: 10;
    margin-top: 1;
    margin-bottom: 1;
}

#firewall-rule-actions {
    width: 1fr;
    height: 3;
}

#firewall-rule-actions Button {
    width: auto;
    min-width: 12;
    margin-right: 1;
}

#firewall-rule-editor {
    display: none;

    width: 42;
    min-width: 36;
    height: auto;

    padding: 1 2;
    border: solid #3a3a3a;
}

#firewall-rule-editor.editing {
    display: block;
}

#firewall-rule-editor Input,
#firewall-rule-editor SpaceSelect {
    width: 1fr;
    height: 3;
    margin-bottom: 1;
}

#firewall-rule-fixed-policy {
    width: 1fr;
    height: auto;

    margin-top: 1;
    margin-bottom: 1;

    color: #8f8f8f;
}

#firewall-rule-editor-actions {
    width: 1fr;
    height: 3;
    margin-top: 1;
}

#firewall-rule-editor-actions Button {
    width: 1fr;
    margin-right: 1;
}

ControlCenterScreen.compact-ui #firewall-rules-layout,
ControlCenterScreen.tiny-ui #firewall-rules-layout {
    layout: vertical;
    height: auto;
}

ControlCenterScreen.compact-ui #firewall-rules-list-panel,
ControlCenterScreen.tiny-ui #firewall-rules-list-panel {
    width: 1fr;
    height: auto;

    min-height: 15;

    margin-right: 0;
    margin-bottom: 1;
}

ControlCenterScreen.compact-ui #firewall-rule-editor,
ControlCenterScreen.tiny-ui #firewall-rule-editor {
    width: 1fr;
    min-width: 1;
    height: auto;
}
