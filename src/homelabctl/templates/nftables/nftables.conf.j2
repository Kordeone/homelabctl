#!/usr/sbin/nft -f

# Managed by HomeLabCTL

flush ruleset

table inet filter {

    set homelabctl_trusted_ipv4 {
        type ipv4_addr
        flags interval
        elements = { {{ management_ipv4_cidr }}{% for cidr in trusted_ipv4_cidrs %}, {{ cidr }}{% endfor %} }
    }

{% if allowed_tcp_ports %}
    set homelabctl_allowed_tcp_ports {
        type inet_service
        elements = { {{ allowed_tcp_ports | join(', ') }} }
    }

{% endif %}
{% if allowed_udp_ports %}
    set homelabctl_allowed_udp_ports {
        type inet_service
        elements = { {{ allowed_udp_ports | join(', ') }} }
    }

{% endif %}
    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept

        ct state invalid drop
        ct state established,related accept

        iifname "{{ management_interface }}" ip saddr {{ management_ipv4_cidr }} tcp dport {{ ssh_port }} ct state new accept

{% if allow_dhcp_client %}
        iifname "{{ management_interface }}" udp sport 67 udp dport 68 accept
{% endif %}

{% if allow_ipv4_icmp %}
        meta l4proto icmp accept
{% endif %}

{% if allow_ipv6_icmp %}
        meta l4proto ipv6-icmp accept
{% endif %}

{% if allowed_tcp_ports %}
        iifname "{{ management_interface }}" ip saddr @homelabctl_trusted_ipv4 tcp dport @homelabctl_allowed_tcp_ports ct state new accept
{% endif %}

{% if allowed_udp_ports %}
        iifname "{{ management_interface }}" ip saddr @homelabctl_trusted_ipv4 udp dport @homelabctl_allowed_udp_ports ct state new accept
{% endif %}
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
